# ===== Обязательно =====
# Токен бота: discord.com/developers/applications → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=
# ID сервера: ПКМ по иконке сервера → Копировать ID сервера (нужен режим разработчика в настройках Discord)
GUILD_ID=

FAMILY_NAME=Ульяновы
FAMILY_NAME_GENITIVE=Ульяновых
GAME_SERVER=Арбатский

# ===== ИИ (необязательно, БЕСПЛАТНО) =====
# Вариант 1 — Groq: console.groq.com → API Keys → Create
GROQ_API_KEY=
# Вариант 2 — Google Gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=
# Без ключа бот работает полностью, отключаются только ИИ-функции.

# ===== Тонкая настройка (можно не трогать) =====
EXAM_QUESTIONS=10
EXAM_PASS=7
EXAM_RETRY_MIN=60
MENTOR_DAYS=7
MARKET_DAYS=7
AI_MODERATION=1
AI_MOD_INTERVAL=180
AI_DAILY_LIMIT=900
